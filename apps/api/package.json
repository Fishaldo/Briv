{
  "name": "@briv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/dev.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test src/*.test.ts",
    "build": "node build.ts",
    "auth:schema": "auth generate --config src/auth-cli.ts --output ../../packages/db/src/auth-schema.generated.ts --yes"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.7",
    "@briv/contract": "workspace:*",
    "@briv/core": "workspace:*",
    "@briv/db": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "auth": "^1.7.7",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  }
}
